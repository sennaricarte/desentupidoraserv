---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BairroCard from '../../components/BairroCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import Hero from '../../components/Hero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { toOgImagePath } from '../../lib/resolve-asset-image';
import negocio from '../../data/negocio.json';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const servicos = await getCollection('servicos');

  return servicos.map((entry) => ({
    params: { servico: entry.data.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'servicos'>;
}

const { entry } = Astro.props;
const { nome, descricao, slug, titulo_seo, meta_descricao, imagem, faq } = entry.data;
const { Content } = await render(entry);

const bairros = (await getCollection('bairros')).sort((a, b) =>
  a.data.nome.localeCompare(b.data.nome, 'pt-BR'),
);

const siteUrl = `https://${negocio.dominio}`;
const pageUrl = `${siteUrl}/servicos/${slug}/`;
const whatsappMensagem = `Olá! Preciso de um orçamento para ${nome.toLowerCase()} em ${negocio.endereco.cidade}.`;

const faqFallback = [
  {
    pergunta: `Como pedir orçamento de ${nome.toLowerCase()}?`,
    resposta:
      'Chame no WhatsApp, descreva o problema e informe o bairro. A equipe orienta o próximo passo e passa o orçamento antes do atendimento.',
  },
];
const faqs = faq && faq.length > 0 ? faq : faqFallback;

const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: nome,
  description: meta_descricao,
  url: pageUrl,
  serviceType: nome,
  areaServed: {
    '@type': 'City',
    name: `${negocio.endereco.cidade}/${negocio.endereco.estado}`,
  },
  provider: {
    '@type': 'LocalBusiness',
    '@id': `${siteUrl}/#localbusiness`,
    name: negocio.nome,
    url: siteUrl,
  },
};

const breadcrumbList = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteUrl}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Serviços',
      item: `${siteUrl}/#servicos`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: nome,
      item: pageUrl,
    },
  ],
};
---

<BaseLayout
  title={titulo_seo}
  description={meta_descricao}
  jsonLd={[service, breadcrumbList]}
  whatsappMensagem={whatsappMensagem}
  ogImage={toOgImagePath(slug, imagem)}
>
  <main id="conteudo-principal">
    <div class="page-wrap pt-lg text-center">
      <nav aria-label="breadcrumb">
        <ol class="m-0 flex list-none flex-wrap items-center justify-center gap-sm p-0 text-sm text-text-muted">
          <li>
            <a href="/" class="text-primary no-underline hover:underline">Home</a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a href="/#servicos" class="text-primary no-underline hover:underline">Serviços</a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-text">{nome}</li>
        </ol>
      </nav>
    </div>

    <Hero
      titulo={`${nome} em ${negocio.endereco.cidade}`}
      descricao={descricao}
      imagem={imagem}
      alt={`${nome} em ${negocio.endereco.cidade}`}
      mensagem={whatsappMensagem}
      secondaryHref="/#bairros"
      secondaryLabel="Ver bairros"
    />

    <section class="bg-bg" aria-label={`Sobre o serviço de ${nome.toLowerCase()}`}>
      <div class="page-wrap pb-3xl">
        <article class="servico-conteudo">
          <Content />
        </article>
      </div>
    </section>

    <section class="bg-bg-alt" aria-labelledby="bairros-servico-titulo">
      <div class="page-wrap py-3xl">
        <SectionHeading
          id="bairros-servico-titulo"
          eyebrow="Onde atendemos"
          title={`Atendemos em todos os bairros de ${negocio.endereco.cidade}`}
        />
        <div class="mt-xl grid gap-md sm:grid-cols-2 lg:grid-cols-3">
          {bairros.map((bairro) => <BairroCard bairro={bairro} />)}
        </div>
      </div>
    </section>

    <CtaBand mensagem={whatsappMensagem} />

    <section class="bg-bg-alt" aria-labelledby="faq-servico-titulo">
      <div class="mx-auto max-w-[48rem] px-md py-3xl">
        <SectionHeading id="faq-servico-titulo" eyebrow="Dúvidas" title="Perguntas frequentes" />
        <div class="mt-xl">
          <FaqAccordion itens={faqs} />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .servico-conteudo {
    max-width: 70ch;
    margin-inline: auto;
    color: var(--color-text);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .servico-conteudo > :global(:first-child) {
    margin-top: 0;
  }

  .servico-conteudo :global(h2) {
    margin: var(--space-2xl) 0 var(--space-md);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .servico-conteudo :global(h3) {
    margin: var(--space-xl) 0 var(--space-sm);
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .servico-conteudo :global(p),
  .servico-conteudo :global(ul),
  .servico-conteudo :global(ol) {
    margin: 0 0 var(--space-md);
  }

  .servico-conteudo :global(ul),
  .servico-conteudo :global(ol) {
    padding-left: var(--space-lg);
  }

  .servico-conteudo :global(ul) {
    list-style: disc;
  }

  .servico-conteudo :global(ol) {
    list-style: decimal;
  }

  .servico-conteudo :global(li + li) {
    margin-top: var(--space-sm);
  }

  .servico-conteudo :global(li::marker) {
    color: var(--color-primary);
  }

  .servico-conteudo :global(strong) {
    font-weight: 700;
  }

  .servico-conteudo :global(a) {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .servico-conteudo :global(a:hover) {
    color: var(--color-primary-dark);
  }
</style>
