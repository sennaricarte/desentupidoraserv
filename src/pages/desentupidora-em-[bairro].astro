---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BairroCard from '../components/BairroCard.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { getBairrosPublicados } from '../lib/bairros';
import { toOgImagePath } from '../lib/resolve-asset-image';
import negocio from '../data/negocio.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/conteudo-longo.css';

export async function getStaticPaths() {
  const bairros = await getBairrosPublicados();

  return bairros.map((entry) => ({
    params: { bairro: entry.data.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'bairros'>;
}

const { entry } = Astro.props;
const { nome, descricao, slug, titulo_seo, meta_descricao, imagem, vias, referencias, faq } = entry.data;
const { Content } = await render(entry);

const servicos = (await getCollection('servicos')).sort((a, b) => a.data.ordem - b.data.ordem);
const outrosBairros = (await getBairrosPublicados()).filter((bairro) => bairro.data.slug !== slug);

const siteUrl = `https://${negocio.dominio}`;
const pageUrl = `${siteUrl}/desentupidora-em-${slug}/`;
const whatsappMensagem = `Olá! Preciso de um orçamento para desentupimento em ${nome}.`;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${siteUrl}/#localbusiness`,
  name: negocio.nome,
  telephone: `+${negocio.whatsapp_numero}`,
  url: siteUrl,
  address: {
    '@type': 'PostalAddress',
    addressLocality: negocio.endereco.cidade,
    addressRegion: negocio.endereco.estado,
    addressCountry: 'BR',
  },
  openingHours: negocio.horario_funcionamento,
  areaServed: nome,
};

const breadcrumbList = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteUrl}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Bairros',
      item: `${siteUrl}/#bairros`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: nome,
      item: pageUrl,
    },
  ],
};
---

<BaseLayout
  title={titulo_seo}
  description={meta_descricao}
  jsonLd={[localBusiness, breadcrumbList]}
  whatsappMensagem={whatsappMensagem}
  ogImage={toOgImagePath(slug, imagem)}
>
  <main id="conteudo-principal">
    <div class="page-wrap pt-lg text-center">
      <nav aria-label="breadcrumb">
        <ol class="m-0 flex list-none flex-wrap items-center justify-center gap-sm p-0 text-sm text-text-muted">
          <li>
            <a href="/" class="text-primary no-underline hover:underline">Home</a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a href="/#bairros" class="text-primary no-underline hover:underline">Bairros</a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-text">{nome}</li>
        </ol>
      </nav>
    </div>

    <Hero
      titulo={`Desentupidora em ${nome}, ${negocio.endereco.cidade}`}
      descricao={descricao}
      imagem={imagem}
      alt={`Desentupidora no bairro ${nome}, em ${negocio.endereco.cidade}`}
      mensagem={whatsappMensagem}
      secondaryHref="/#servicos"
      secondaryLabel="Ver serviços"
    />

    <section class="bg-bg" aria-label={`Desentupidora em ${nome}`}>
      <div class="page-wrap pb-3xl">
        <article class="conteudo-longo">
          <Content />
        </article>
      </div>
    </section>

    <section class="bg-bg-alt" aria-labelledby="onde-atendemos-titulo">
      <div class="page-wrap py-3xl">
        <SectionHeading
          id="onde-atendemos-titulo"
          eyebrow="Localização"
          title={`Onde atendemos em ${nome}`}
        />
        <div class="mx-auto mt-xl grid max-w-5xl gap-md md:grid-cols-2">
          <div class="rounded-2xl bg-bg p-lg shadow-sm">
            <h3 id="vias-titulo" class="m-0 text-xl font-bold">Vias</h3>
            <ul class="mt-md mb-0 flex list-none flex-col gap-sm p-0" aria-labelledby="vias-titulo">
              {vias.map((via) => <li>{via}</li>)}
            </ul>
          </div>
          <div class="rounded-2xl bg-bg p-lg shadow-sm">
            <h3 id="referencias-titulo" class="m-0 text-xl font-bold">Referências</h3>
            <ul class="mt-md mb-0 flex list-none flex-col gap-md p-0" aria-labelledby="referencias-titulo">
              {
                referencias.map((referencia) => (
                  <li>
                    <span class="font-semibold">{referencia.nome}</span>
                    <span class="block text-sm text-text-muted">
                      {referencia.tipo}
                      {referencia.endereco && ` · ${referencia.endereco}`}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-bg" aria-labelledby="servicos-bairro-titulo">
      <div class="page-wrap py-3xl">
        <SectionHeading
          id="servicos-bairro-titulo"
          eyebrow="Serviços no bairro"
          title="Serviços que atendemos neste bairro"
        />
        <div class="mt-xl grid gap-md md:grid-cols-2 lg:grid-cols-3">
          {servicos.map((servico) => <ServiceCard servico={servico} />)}
        </div>
      </div>
    </section>

    <CtaBand mensagem={whatsappMensagem} />

    {
      faq && faq.length > 0 && (
        <section class="bg-bg-alt" aria-labelledby="faq-bairro-titulo">
          <div class="mx-auto max-w-[48rem] px-md py-3xl">
            <SectionHeading id="faq-bairro-titulo" eyebrow="Dúvidas" title={`Perguntas sobre ${nome}`} />
            <div class="mt-xl">
              <FaqAccordion itens={faq} />
            </div>
          </div>
        </section>
      )
    }

    <section class="bg-bg" aria-labelledby="outros-bairros-titulo">
      <div class="page-wrap py-3xl">
        <SectionHeading id="outros-bairros-titulo" eyebrow="Mais cobertura" title="Outros bairros atendidos" />
        <p class="mt-lg mb-lg text-center">
          <a href="/" class="font-heading font-semibold text-primary no-underline hover:text-primary-dark">
            Voltar para a home
          </a>
        </p>
        <div class="grid gap-md sm:grid-cols-2 lg:grid-cols-3">
          {outrosBairros.map((bairro) => <BairroCard bairro={bairro} />)}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
