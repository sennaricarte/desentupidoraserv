---
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/latin-700.css';
import manrope400 from '@fontsource/manrope/files/manrope-latin-400-normal.woff2?url';
import manrope700 from '@fontsource/manrope/files/manrope-latin-700-normal.woff2?url';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import negocio from '../data/negocio.json';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  whatsappMensagem?: string;
}

const {
  title,
  description = `Desentupidora em ${negocio.endereco.cidade}/${negocio.endereco.estado}. Atendimento ${negocio.horario_funcionamento}.`,
  canonicalUrl,
  ogImage,
  ogType = 'website',
  jsonLd,
  whatsappMensagem,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(`https://${negocio.dominio}`);
const resolvedCanonical = canonicalUrl ?? new URL(Astro.url.pathname, siteUrl).href;
const ogImagePath = ogImage ?? '/images/og-default.jpg';
const ogImageUrl = ogImagePath.startsWith('http')
  ? ogImagePath
  : new URL(ogImagePath, siteUrl).href;
const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" as="font" type="font/woff2" href={manrope700} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={manrope400} crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={resolvedCanonical} />
    <meta name="theme-color" content="#0B5FA5" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={negocio.nome} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      schemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body class="min-h-screen bg-bg text-text font-body">
    <a
      href="#conteudo-principal"
      class="sr-only focus:not-sr-only focus:absolute focus:top-sm focus:left-sm focus:z-50 focus:bg-primary focus:px-md focus:py-sm focus:text-white"
    >
      Ir para o conteúdo principal
    </a>
    <Header />
    <slot />
    <Footer />
    <WhatsAppButton mensagem={whatsappMensagem} />
  </body>
</html>
