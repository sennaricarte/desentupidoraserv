---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<span
  class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-primary/10 text-primary"
  aria-hidden="true"
>
  {
    name === 'vaso' ? (
      <svg width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7 8.5h10a2 2 0 0 1 2 2V12H5v-1.5a2 2 0 0 1 2-2Z"></path>
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14v1.5A6.5 6.5 0 0 1 12.5 20h-1A6.5 6.5 0 0 1 5 13.5V12Z"></path>
        <path stroke-linecap="round" d="M12 20v2"></path>
      </svg>
    ) : name === 'ralo' ? (
      <svg width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <circle cx="12" cy="12" r="8"></circle>
        <path stroke-linecap="round" d="M12 8v8M8 12h8M9.2 9.2l5.6 5.6M14.8 9.2l-5.6 5.6"></path>
      </svg>
    ) : name === 'esgoto' ? (
      <svg width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 8h7v4H4zM13 12h7v4h-7z"></path>
        <path stroke-linecap="round" d="M11 10h2M8 12v4M16 12V8"></path>
      </svg>
    ) : name === 'hidrojato' ? (
      <svg width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15h6l2-4h6"></path>
        <path stroke-linecap="round" d="M19 7v4M17 8.5h4M19 15.5v3M17.5 17h3"></path>
      </svg>
    ) : (
      <svg width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 10h10v7H8a4 4 0 0 1-4-4v-3Z"></path>
        <path stroke-linecap="round" d="M14 13h3.5a2.5 2.5 0 0 0 0-5H14"></path>
      </svg>
    )
  }
</span>
