---
import type { CollectionEntry } from 'astro:content';

interface Props {
  bairro: CollectionEntry<'bairros'>;
}

const { bairro } = Astro.props;
const { nome, slug } = bairro.data;
---

<article class="rounded-2xl bg-bg p-lg shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-lg">
  <span
    class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-primary/10 text-primary"
    aria-hidden="true"
  >
    <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z"></path>
      <circle cx="12" cy="10" r="2.4"></circle>
    </svg>
  </span>
  <h3 class="mt-md mb-sm text-xl font-bold">
    <a href={`/desentupidora-em-${slug}/`} class="text-text no-underline hover:text-primary">
      {nome}
    </a>
  </h3>
  <a
    href={`/desentupidora-em-${slug}/`}
    class="font-heading text-sm font-semibold text-primary no-underline hover:text-primary-dark"
  >
    Ver cobertura
  </a>
</article>
