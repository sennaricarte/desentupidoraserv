---
import negocio from '../data/negocio.json';

interface Props {
  mensagem?: string;
  variant?: 'float' | 'cta';
  label?: string;
  size?: 'sm' | 'md';
}

const {
  mensagem = negocio.whatsapp_mensagem_padrao,
  variant = 'float',
  label = 'Chamar no WhatsApp',
  size = 'md',
} = Astro.props;

const href = `https://wa.me/${negocio.whatsapp_numero}?text=${encodeURIComponent(mensagem)}`;
const isCta = variant === 'cta';
const isSmall = size === 'sm';
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center text-white no-underline hover:bg-accent-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
    isCta
      ? [
          'gap-sm rounded-full bg-accent font-heading font-bold',
          isSmall ? 'px-md py-sm text-sm' : 'px-lg py-md',
        ]
      : 'fixed right-lg bottom-lg z-50 h-14 w-14 rounded-full bg-accent shadow-lg',
  ]}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chamar no WhatsApp"
>
  <svg aria-hidden="true" width={isCta ? 20 : 28} height={isCta ? 20 : 28} viewBox="0 0 24 24" fill="currentColor">
    <path
      d="M20.5 3.5A11 11 0 0 0 2.1 17.7L1 23l5.4-1.1A11 11 0 0 0 12 23a11 11 0 0 0 8.5-19.5ZM12 21a9 9 0 0 1-4.6-1.3l-.3-.2-3.2.7.7-3.1-.2-.3A9 9 0 1 1 12 21Zm5-6.7c-.3-.1-1.6-.8-1.8-.9s-.4-.1-.6.2-.7.9-.8 1-.3.2-.6.1a7.4 7.4 0 0 1-2.2-1.4 8.2 8.2 0 0 1-1.5-1.9c-.2-.3 0-.4.1-.6l.4-.4.2-.3a1.4 1.4 0 0 0 0-.5c0-.2-.6-1.5-.8-2s-.4-.5-.6-.5h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-1 2.2 5.3 5.3 0 0 0 1.1 2.8 12 12 0 0 0 4.6 4.1 15.7 15.7 0 0 0 1.6.6 3.8 3.8 0 0 0 1.8.1 2.9 2.9 0 0 0 1.9-1.3 2.4 2.4 0 0 0 .2-1.3c-.1-.1-.3-.2-.6-.3Z"
    ></path>
  </svg>
  {isCta && <span>{label}</span>}
</a>
