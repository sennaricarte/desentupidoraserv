---
import { Image } from 'astro:assets';
import { resolveAssetImage } from '../lib/resolve-asset-image';
import negocio from '../data/negocio.json';
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  titulo?: string;
  descricao?: string;
  imagem?: string;
  alt?: string;
  mensagem?: string;
  destaque?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  badge?: string;
}

const {
  titulo = `Desentupidora em ${negocio.endereco.cidade} 24 Horas`,
  descricao = `Atendimento emergencial rápido para pia, vaso, ralo e esgoto. Equipe pronta todos os dias, inclusive feriados, em ${negocio.endereco.cidade} e região.`,
  imagem,
  alt = `Desentupidora em ${negocio.endereco.cidade}`,
  mensagem = negocio.whatsapp_mensagem_padrao,
  destaque,
  secondaryHref,
  secondaryLabel = 'Ver serviços',
  badge = '24h',
} = Astro.props;

const heroImage = resolveAssetImage(imagem);
const destaqueIndex = destaque ? titulo.indexOf(destaque) : -1;
const tituloAntes = destaqueIndex >= 0 ? titulo.slice(0, destaqueIndex).trimEnd() : titulo;
const tituloDepois = destaqueIndex >= 0 ? titulo.slice(destaqueIndex + destaque!.length) : '';
---

<section class="relative overflow-hidden bg-bg" aria-labelledby="hero-titulo">
  <div class="pointer-events-none absolute top-16 right-[8%] h-3 w-3 rounded-full bg-primary/25" aria-hidden="true"></div>
  <div class="pointer-events-none absolute top-28 right-[14%] h-2 w-2 rounded-full bg-primary/20" aria-hidden="true"></div>
  <div class="pointer-events-none absolute bottom-24 left-[6%] h-2.5 w-2.5 rounded-full bg-primary/15" aria-hidden="true"></div>

  <div class="page-wrap relative py-3xl">
    <div class="mx-auto max-w-4xl text-center">
      <p class="m-0 mb-md font-heading text-sm font-bold tracking-wide text-primary uppercase">
        {negocio.nome} · {negocio.endereco.cidade}/{negocio.endereco.estado}
      </p>
      <h1 id="hero-titulo" class="m-0 text-4xl font-bold leading-tight tracking-tight md:text-5xl">
        {
          destaqueIndex >= 0 ? (
            <>
              {tituloAntes}
              <br />
              <span class="text-primary">{destaque}</span>
              {tituloDepois}
            </>
          ) : (
            titulo
          )
        }
      </h1>
      <p class="mx-auto mt-lg mb-xl max-w-[48rem] text-lg text-text-muted">
        {descricao}
      </p>
      <div class="flex flex-wrap items-center justify-center gap-md">
        <WhatsAppButton variant="cta" mensagem={mensagem} />
        {
          secondaryHref && (
            <a
              href={secondaryHref}
              class="inline-flex items-center justify-center rounded-full border-2 border-primary px-lg py-md font-heading font-bold text-primary no-underline hover:bg-primary hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              {secondaryLabel}
            </a>
          )
        }
      </div>
    </div>

    <div class="relative mx-auto mt-2xl mb-xl max-w-5xl">
      <div class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-primary to-primary-dark shadow-[0_24px_60px_rgb(11_95_165/0.22)]">
        {
          heroImage ? (
            <Image
              src={heroImage}
              alt={alt}
              width={1600}
              height={900}
              format="webp"
              quality="mid"
              loading="eager"
              fetchpriority="high"
              class="aspect-video h-full w-full object-cover object-[center_75%]"
              sizes="(min-width: 1024px) 1024px, 100vw"
            />
          ) : (
            <div class="relative aspect-video min-h-64" aria-hidden="true">
              <svg class="absolute inset-0 m-auto h-24 w-24 text-white/20" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.2s-6.2 7.4-6.2 11.3a6.2 6.2 0 1 0 12.4 0C18.2 9.6 12 2.2 12 2.2Z"></path>
              </svg>
            </div>
          )
        }
      </div>
      <div
        class="absolute bottom-5 left-5 flex h-24 w-24 flex-col items-center justify-center rounded-full bg-bg text-center text-primary shadow-lg sm:left-8"
        aria-hidden="true"
      >
        <span class="font-heading text-2xl font-bold leading-none">{badge}</span>
        <span class="mt-xs text-[11px] font-semibold tracking-wide uppercase">Atendimento</span>
      </div>
    </div>
  </div>
</section>
