---
interface Item {
  valor: string;
  label: string;
}

interface Props {
  itens: Item[];
}

const { itens } = Astro.props;
---

<section class="relative z-10 -mt-xl" aria-label="Diferenciais do atendimento">
  <div class="page-wrap grid gap-lg rounded-2xl bg-bg px-lg py-xl shadow-[0_16px_40px_rgb(26_26_26/0.08)] sm:grid-cols-2 lg:grid-cols-4">
    {
      itens.map((item) => (
        <div class="px-sm text-center">
          <p class="m-0 font-heading text-3xl font-bold text-primary">{item.valor}</p>
          <p class="mt-xs mb-0 text-sm text-text-muted">{item.label}</p>
        </div>
      ))
    }
  </div>
</section>
